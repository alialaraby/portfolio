{
  "name": "ali-alaraby-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Ali Alaraby's content-led professional engineering portfolio.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "content:check": "vitest run tests/content.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "astro": "7.3.3",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
