---
import { getCollection, type CollectionEntry } from 'astro:content';
import ActionLink from '../../components/ActionLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies');

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
---

<BaseLayout title={`${entry.data.title} — Ali Alaraby`} description={entry.data.description}>
  <article class="case-shell">
    <ActionLink href="/#selected-work">← Back to selected work</ActionLink>
    <p class="eyebrow">{entry.data.classification.replace('-', ' ')} · Case study preview</p>
    <h1>{entry.data.title}</h1>
    <p class="case-shell__lede">{entry.data.description}</p>
    <div class="notice-panel">
      <p class="eyebrow">Presentation status</p>
      <p>
        This route demonstrates the responsive reading shell. The complete approved case study and
        technical storytelling remain deferred to Phase 7.
      </p>
    </div>
  </article>
</BaseLayout>
