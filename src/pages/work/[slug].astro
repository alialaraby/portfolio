---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ActionLink from '../../components/ActionLink.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import { absoluteUrl, site, withBasePath } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('caseStudies')).sort(
    (left, right) => left.data.order - right.data.order,
  );

  return entries.map((entry) => ({
    params: { slug: entry.data.route.split('/').at(-1) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;

const sorted = (await getCollection('caseStudies')).sort(
  (left, right) => left.data.order - right.data.order,
);
const currentIndex = sorted.findIndex((candidate) => candidate.id === entry.id);
const previous = currentIndex > 0 ? sorted[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : undefined;

const { Content: CaseStudyContent } = await render(entry);

const hasLinks = Boolean(entry.data.repository || entry.data.package);

const canonical = absoluteUrl(`${entry.data.route}/`);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: entry.data.headerTitle ?? entry.data.title,
    description: entry.data.description,
    url: canonical,
    mainEntityOfPage: canonical,
    inLanguage: site.locale,
    author: {
      '@type': 'Person',
      name: site.name,
      url: absoluteUrl(),
    },
    isPartOf: {
      '@type': 'WebSite',
      name: site.name,
      url: absoluteUrl(),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: absoluteUrl(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Selected work',
        item: `${absoluteUrl()}#selected-work`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: entry.data.title,
        item: canonical,
      },
    ],
  },
];
---

<BaseLayout
  title={`${entry.data.title} — Ali Alaraby`}
  description={entry.data.description}
  type="article"
  structuredData={structuredData}
>
  <article class="case-shell">
    <ActionLink href={withBasePath('/#selected-work')}>← Back to selected work</ActionLink>

    <header class="case-shell__header">
      <p class="eyebrow">{entry.data.classification.replace('-', ' ')} · Case study</p>
      <h1>{entry.data.headerTitle ?? entry.data.title}</h1>
      {entry.data.caseContext && <p class="work-card__context">{entry.data.caseContext}</p>}
      {entry.data.caseLocation && <p class="location-line">{entry.data.caseLocation}</p>}
      <p class="case-shell__lede">{entry.data.description}</p>
    </header>

    <dl class="case-meta">
      <div class="case-meta__item">
        <dt>Classification</dt>
        <dd>{entry.data.classification.replace('-', ' ')}</dd>
      </div>
      <div class="case-meta__item">
        <dt>Project</dt>
        <dd>{entry.data.project}</dd>
      </div>
      <div class="case-meta__item">
        <dt>Role</dt>
        <dd>{entry.data.role}</dd>
      </div>
      {entry.data.timeline && (
        <div class="case-meta__item">
          <dt>Timeline</dt>
          <dd>{entry.data.timeline}</dd>
        </div>
      )}
    </dl>

    <section class="case-evidence case-diagram" aria-labelledby="case-results-title">
      <div>
        <p class="eyebrow">Key evidence</p>
        <h2 id="case-results-title">Results at a glance</h2>
        <ul class="work-card__highlights">
          {entry.data.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Technology</p>
        <ul class="chip-list" aria-label={`${entry.data.project} technologies`}>
          {entry.data.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </div>
    </section>

    <section class="case-diagram" aria-labelledby="case-diagram-title">
      <p class="eyebrow">
        {entry.data.classification === 'open-source' ? 'Package flow' : 'Simplified conceptual view'}
      </p>
      <h2 id="case-diagram-title">{entry.data.diagram.label}</h2>
      <FlowDiagram steps={entry.data.diagram.steps} ariaLabel={`${entry.data.diagram.label}, numbered steps`} />
      {entry.data.classification === 'professional-system' && (
        <p class="case-diagram__note">
          This intentionally high-level view communicates the relevant boundaries without representing the complete production architecture.
        </p>
      )}
    </section>

    <div class="prose case-prose">
      <CaseStudyContent />
    </div>

    {hasLinks && (
      <section class="case-links" aria-labelledby="case-links-title">
        <h2 id="case-links-title">Source and package</h2>
        <div class="action-group">
          {entry.data.repository && (
            <ActionLink href={entry.data.repository} variant="secondary" external>
              GitHub repository
            </ActionLink>
          )}
          {entry.data.package && (
            <ActionLink href={entry.data.package} variant="secondary" external>
              npm package
            </ActionLink>
          )}
        </div>
      </section>
    )}

    <nav class="case-nav" aria-label="Case study navigation">
      {previous && (
        <a class="case-nav__link case-nav__link--previous" href={withBasePath(previous.data.route)}>
          <span class="eyebrow">Previous</span>
          <strong>{previous.data.title}</strong>
        </a>
      )}
      {next && (
        <a class="case-nav__link case-nav__link--next" href={withBasePath(next.data.route)}>
          <span class="eyebrow">Next</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
