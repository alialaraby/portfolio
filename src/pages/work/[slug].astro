---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies');

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
---

<BaseLayout title={`${entry.data.title} — Ali Alaraby`} description={entry.data.description}>
  <article>
    <p><a href="/#selected-work">Back to selected work</a></p>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
    <p>
      This temporary Phase 4 route validates content-driven static generation. The approved case
      study presentation is deferred to Phase 7.
    </p>
  </article>
</BaseLayout>
