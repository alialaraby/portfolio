---
import { getCollection } from 'astro:content';
import CaseStudyList from '../components/CaseStudyList.astro';
import ActionLink from '../components/ActionLink.astro';
import SectionShell from '../components/SectionShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const caseStudies = (await getCollection('caseStudies')).sort(
  (left, right) => left.data.order - right.data.order,
);
const requiredPages = ['capabilities', 'experience', 'home', 'open-source', 'page-metadata'];
const pageIds = new Set((await getCollection('pages')).map((entry) => entry.id));

for (const requiredPage of requiredPages) {
  if (!pageIds.has(requiredPage)) {
    throw new Error(`Missing required approved content: ${requiredPage}.md`);
  }
}
---

<BaseLayout>
  <section class="hero-shell" aria-labelledby="page-title">
    <p class="eyebrow">Phase 5 · Visual system preview</p>
    <h1 id="page-title">A clear shell for evidence-led engineering work.</h1>
    <p class="hero-shell__lede">
      This page demonstrates the portfolio’s typography, spacing, responsive structure, and
      interaction states. Approved homepage composition remains intentionally deferred to Phase 6.
    </p>
    <div class="action-group">
      <ActionLink href="#selected-work" variant="primary">View selected work</ActionLink>
      <ActionLink href="mailto:alisakralaraby@gmail.com" variant="secondary">Contact Ali</ActionLink>
    </div>
  </section>
  <SectionShell id="selected-work" eyebrow="Content-driven routes" title="Selected work">
    <CaseStudyList entries={caseStudies} />
  </SectionShell>
</BaseLayout>
