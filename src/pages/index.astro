---
import { getCollection, getEntry, render } from 'astro:content';
import ActionLink from '../components/ActionLink.astro';
import CaseStudyList from '../components/CaseStudyList.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Portrait from '../components/Portrait.astro';
import SectionShell from '../components/SectionShell.astro';
import { absoluteUrl, site, withBasePath } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const caseStudies = (await getCollection('caseStudies')).sort(
  (left, right) => left.data.order - right.data.order,
);

const [home, capabilities, experience, openSource] = await Promise.all([
  getEntry('pages', 'home'),
  getEntry('pages', 'capabilities'),
  getEntry('pages', 'experience'),
  getEntry('pages', 'open-source'),
]);

if (!home || home.data.kind !== 'homepage' || !capabilities || !experience || !openSource) {
  throw new Error('Required approved homepage content is missing or malformed.');
}

const { Content: CapabilitiesContent } = await render(capabilities);
const { Content: OpenSourceContent } = await render(openSource);

const canonical = absoluteUrl();
const cv = withBasePath(home.data.cv);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: canonical,
    name: site.title,
    description: site.description,
    mainEntity: {
      '@type': 'Person',
      name: site.name,
      jobTitle: 'Senior Backend Engineer',
      url: canonical,
      email: `mailto:${home.data.email}`,
      description: site.description,
      sameAs: [home.data.github, home.data.linkedin],
    },
  },
];
---

<BaseLayout structuredData={structuredData}>
  <section class="hero-shell" aria-labelledby="page-title">
    <div class="hero-shell__content">
      <p class="eyebrow">{home.data.eyebrow}</p>
      <h1 id="page-title">{home.data.headline}</h1>
      <div class="hero-shell__lede">
        {home.data.introduction.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="location-line">{home.data.location}</p>
      <div class="action-group">
        <ActionLink href="#selected-work" variant="primary">View selected work</ActionLink>
        <ActionLink href={`mailto:${home.data.email}`} variant="secondary">Contact me</ActionLink>
        <ActionLink href={cv} variant="secondary">Download CV</ActionLink>
      </div>
    </div>
    <Portrait />
  </section>

  <section class="proof-strip" aria-label="Selected evidence">
    <ul role="list">
      {
        home.data.proof.map((item) => (
          <li>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <SectionShell id="about" eyebrow="How I work" title="I stay close to the real constraint.">
    <div class="prose prose--lead">
      {home.data.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </SectionShell>

  <SectionShell id="selected-work" eyebrow="Evidence in context" title="Selected work">
    <p class="section-introduction">{home.data.selectedWorkIntroduction}</p>
    <CaseStudyList entries={caseStudies} />
  </SectionShell>

  <SectionShell id="capabilities" eyebrow="Problems I solve" title="Engineering capabilities">
    <div class="prose content-grid"><CapabilitiesContent /></div>
  </SectionShell>

  <SectionShell id="experience" eyebrow="Career progression" title="Experience">
    {
      experience.data.kind === 'experience' && (
        <ExperienceTimeline
          introduction={experience.data.introduction}
          roles={experience.data.roles}
          closingTitle={experience.data.closingTitle}
          closing={experience.data.closing}
        />
      )
    }
    <div class="section-note" role="note">
      <p>
        <strong>Curriculum vitae:</strong>
        <a href={cv}>Download the approved PDF</a> for the full professional record.
      </p>
    </div>
  </SectionShell>

  <SectionShell id="open-source" eyebrow="Inspectable engineering" title="Open source">
    <div class="prose feature-panel"><OpenSourceContent /></div>
  </SectionShell>

  <SectionShell id="contact" eyebrow="Start a conversation" title="Let’s talk about the system.">
    <div class="contact-panel">
      <div class="prose prose--lead">
        {home.data.contact.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="action-group">
        <ActionLink href={`mailto:${home.data.email}`} variant="primary">Email me</ActionLink>
        <ActionLink href={home.data.linkedin} variant="secondary" external>LinkedIn</ActionLink>
        <ActionLink href={home.data.github} variant="secondary" external>GitHub</ActionLink>
        <ActionLink href={cv} variant="secondary">Download CV</ActionLink>
      </div>
    </div>
  </SectionShell>
</BaseLayout>
