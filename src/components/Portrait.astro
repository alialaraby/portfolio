---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBasePath } from '../config/site';

type Props =
  | {
      src: string | ImageMetadata;
      alt: string;
      width: number;
      height: number;
      focalPosition?: string;
    }
  | {
      src?: undefined;
      alt?: undefined;
      width?: number;
      height?: number;
      focalPosition?: string;
    };

const { src, alt, width = 720, height = 880, focalPosition = '50% 35%' } = Astro.props;
const imageSrc = typeof src === 'string' && src.startsWith('/') ? withBasePath(src) : src;
---

<figure class:list={['portrait', imageSrc && 'portrait--image']}>
  {
    imageSrc && typeof imageSrc !== 'string' ? (
      <Image
        src={imageSrc}
        alt={alt}
        width={width}
        height={height}
        format="webp"
        quality={85}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        style={`object-position: ${focalPosition}`}
      />
    ) : imageSrc ? (
      <img
        src={imageSrc}
        alt={alt}
        width={width}
        height={height}
        decoding="async"
        fetchpriority="high"
        style={`object-position: ${focalPosition}`}
      />
    ) : (
      <div class="portrait__placeholder" aria-hidden="true">
        <span class="portrait__grid" />
        <span class="portrait__monogram">AA</span>
        <span class="portrait__caption">Backend · systems · delivery</span>
      </div>
    )
  }
</figure>
