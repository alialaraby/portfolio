---
interface Props {
  href?: string;
  label?: string;
}

const { href, label } = Astro.props;
---

<article class="surface-card">
  {label && <p class="eyebrow">{label}</p>}
  <slot />
  {href && <a class="surface-card__link" href={href}>View route <span aria-hidden="true">→</span></a>}
</article>
