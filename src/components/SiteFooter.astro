---
import { getEntry } from 'astro:content';
import ActionLink from './ActionLink.astro';
import { withBasePath } from '../config/site';

const home = await getEntry('pages', 'home');
const cv = home?.data.kind === 'homepage' ? home.data.cv : undefined;
const location = home?.data.kind === 'homepage' ? home.data.location : undefined;
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <p class="eyebrow">Senior Backend Engineer</p>
      <p class="site-footer__name">Ali Alaraby</p>
    </div>
    <nav class="site-footer__links" aria-label="Professional profiles">
      <ActionLink href="mailto:alisakralaraby@gmail.com">Email</ActionLink>
      <ActionLink href="https://www.linkedin.com/in/ali-sakr-alarby" external>LinkedIn</ActionLink>
      <ActionLink href="https://github.com/alialaraby" external>GitHub</ActionLink>
      {cv && <ActionLink href={withBasePath(cv)}>CV</ActionLink>}
    </nav>
    {location && <p class="site-footer__note">{location}</p>}
  </div>
</footer>
