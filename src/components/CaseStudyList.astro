---
import type { CollectionEntry } from 'astro:content';
import { withBasePath } from '../config/site';
import SurfaceCard from './SurfaceCard.astro';

interface Props {
  entries: CollectionEntry<'caseStudies'>[];
}

const { entries } = Astro.props;
---

<ul class="card-grid" role="list">
  {
    entries.map((entry) => (
      <li>
        <SurfaceCard href={withBasePath(entry.data.route)} label={entry.data.classification.replace('-', ' ')}>
          <p class="work-card__context">{entry.data.cardContext}</p>
          <h3>{entry.data.project}</h3>
          <p class="work-card__problem">{entry.data.cardProblem}</p>
          <ul class="work-card__highlights">
            {entry.data.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <ul class="chip-list" aria-label={`${entry.data.project} technologies`}>
            {entry.data.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
        </SurfaceCard>
      </li>
    ))
  }
</ul>
