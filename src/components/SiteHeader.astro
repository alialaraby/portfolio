---
import { withBasePath } from '../config/site';
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href={withBasePath()} aria-label="Ali Alaraby, homepage">
      <span class="wordmark__name">Ali Alaraby</span>
      <span class="wordmark__role">Backend Engineer</span>
    </a>
    <div class="site-header__actions">
      <nav aria-label="Primary">
        <a href={withBasePath()}>Home</a>
        <a href={withBasePath('/#selected-work')}>Selected work</a>
        <a href={withBasePath('/#capabilities')}>Capabilities</a>
        <a href={withBasePath('/#experience')}>Experience</a>
        <a href={withBasePath('/#contact')}>Contact</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" hidden>
        <svg class="theme-toggle__sun" aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3.5" />
          <path d="M12 2v2.25M12 19.75V22M2 12h2.25M19.75 12H22M4.93 4.93l1.6 1.6M17.47 17.47l1.6 1.6M19.07 4.93l-1.6 1.6M6.53 17.47l-1.6 1.6" />
        </svg>
        <svg class="theme-toggle__moon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M20.25 15.2A8.6 8.6 0 0 1 8.8 3.75 8.6 8.6 0 1 0 20.25 15.2Z" />
        </svg>
      </button>
    </div>
  </div>
</header>
