---
import type { z } from 'astro/zod';
import type { experienceSchema } from '../content/schema';

type Experience = z.infer<typeof experienceSchema>;

interface Props {
  introduction: Experience['introduction'];
  roles: Experience['roles'];
  closingTitle: Experience['closingTitle'];
  closing: Experience['closing'];
}

const { introduction, roles, closingTitle, closing } = Astro.props;
---

<div class="experience">
  <p class="experience__introduction">{introduction}</p>
  <ol class="timeline" aria-label="Career history">
    {
      roles.map((role) => (
        <li class="timeline__entry">
          <article class="timeline__content">
            <header class="timeline__header">
              <h3>{role.company}</h3>
              <div class="timeline__positions">
                {role.positions.map((position) => (
                  <p>
                    <strong>{position.title}</strong>
                    <span>{position.timeline}</span>
                  </p>
                ))}
              </div>
            </header>
            <p>{role.summary}</p>
            <ul>
              {role.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
            {role.note && <p class="timeline__note">{role.note}</p>}
          </article>
        </li>
      ))
    }
  </ol>
  <div class="experience__closing">
    <h3>{closingTitle}</h3>
    <p>{closing}</p>
  </div>
</div>
